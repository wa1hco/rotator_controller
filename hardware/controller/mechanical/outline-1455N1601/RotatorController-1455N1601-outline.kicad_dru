(version 1)
# JLCPCB 4-layer extras (jlcpcb.com/capabilities/pcb-capabilities, read 2026-10-11)
(rule "JLC inner-layer PTH to copper 0.3"
	(layer inner)
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'Through-hole'"))
(rule "JLC via hole to copper 0.2"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'Via'"))
(rule "JLC PTH annular ring 0.2 (recommended)"
	(constraint annular_width (min 0.2mm))
	(condition "A.Pad_Type == 'Through-hole'"))
(rule "JLC min NPTH 0.5"
	(constraint hole_size (min 0.5mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))
(rule "JLC pad-to-pad hole spacing 0.45"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))
