	(hierarchical_label "I_SENSE" (shape bidirectional) (at 38.1 241.3 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "ec1b9ab5-e35a-4a62-9c88-78230d48b05c"))
	(hierarchical_label "I_ADC" (shape bidirectional) (at 114.3 241.3 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d4b074d3-fb70-450b-8047-be380da8f4b4"))
	(text "Analog front end.\nAzimuth ends are AZ_POT_3 and AZ_POT_7 from the rotor sheet. The wiper is ROTOR_RETURN.\n330 ohm from +3V3, then 1k, BAT54 clamps, then 10k and 100 nF (about 159 Hz).\nElevation is the same circuit. J20 is TBD (Mouser, through-hole).\nD260 and D261 are SMAJ90CA, LCSC C5353147. Azimuth clamps D6 and D7 stay on the rotor sheet.\nTR1 and its conditioning stay on rotor_drive. I_SENSE is only carried across to I_ADC.\nVIN_WARN is 39k over 1k into the comparator, with no capacitor." (exclude_from_sim no) (at 203.2 30.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5035aef6-a19b-4762-99b5-fc01074d74ed"))
